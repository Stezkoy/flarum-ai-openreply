{
    "name": "stezkoy/flarum-ai-openreply",
    "description": "AI Open-Reply Extension for Flarum, powered by opencode.",
    "keywords": [
        "flarum",
        "ai",
        "openreply",
        "autoreply",
        "opencode",
        "assistant",
        "chatbot"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "flarum/core": "^2.0.0-rc.1",
        "guzzlehttp/guzzle": "^7.10"
    },
    "authors": [
        {
            "name": "Ngo Quoc Dat",
            "email": "datlechin@gmail.com",
            "role": "Original Developer",
            "homepage": "https://ngoquocdat.dev"
        },
        {
            "name": "Michael V.",
            "email": "michael@michaelbelgium.me",
            "role": "Developer",
            "homepage": "https://michaelbelgium.me"
        },
        {
            "name": "stezkoy",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/stezkoy/flarum-ai-openreply",
        "forum": "https://discuss.flarum.org/d/38244"
    },
    "autoload": {
        "psr-4": {
            "Stezkoy\\FlarumAIOpenReply\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "AI Open-Reply",
            "category": "feature",
            "icon": {
                "image": "icon.svg"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": false,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": false
            }
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}